{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": false,
    "paths": { "$lib/*": ["./src/lib/*"] }
  },
  "include": ["src/**/*.js", "src/**/*.svelte", "src/**/*.d.ts"]
}
